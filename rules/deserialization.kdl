rule "InsecureDeserialization" severity="High" {
    sinks {
        sink "JSON.parse" {
            // Safe if input was validated through schema validation or input checking
            sanitizer "schema.validate"
            sanitizer "Schema.parse"
            sanitizer "Schema.from_json"
            sanitizer "check_json"
            sanitizer "validate_json"
            sanitizer "JSON::Schema.new"
            fix "JSON.parse(schema.validate({arg0}))"
        }
        sink "YAML.parse" {
            fix "YAML.parse(schema.validate({arg0}))"
        }
        sink "XML.parse" {
            fix "Use a safe XML parser with entity expansion disabled"
        }
        sink "Marshal.load" {
            fix "Never deserialize untrusted data with Marshal.load — use JSON or a schema-validated format"
        }
        sink "Oj.load" {
            fix "Oj.load({arg0}, mode: :strict) or use Oj.safe_load"
        }
        sink "json.decode" {
            fix "json.decode(schema.validate({arg0}))"
        }
        sink "yaml.parse" {
            fix "yaml.parse(schema.validate({arg0}))"
        }
    }
    sources {
        source "params"
        source "request"
        source "body"
        source "user_input"
    }
    message "Potential insecure deserialization via {sink}. Deserializing untrusted data can lead to RCE."
}
