rule "WeakCryptography" severity="Medium" {
    sinks {
        sink "Digest::MD5" {
            fix "Use Digest::SHA256.hexdigest or OpenSSL::Digest.new(\"sha256\")"
        }
        sink "Digest::SHA1" {
            fix "Use Digest::SHA256.hexdigest or OpenSSL::Digest.new(\"sha256\")"
        }
        sink "hashlib.md5" {
            fix "hashlib.sha256({arg0}) instead of hashlib.md5"
        }
        sink "hashlib.sha1" {
            fix "hashlib.sha256({arg0}) instead of hashlib.sha1"
        }
    }
    conditions {
        skip_taint_check
    }
    message "Weak cryptography: {sink} uses a weak hashing algorithm (MD5/SHA1). Use SHA-256 or stronger."
}

rule "InsecureRandom" severity="Low" {
    sinks {
        sink "int.random" {
            fix "Use a CSPRNG for security contexts"
        }
        sink "float.random" {
            fix "Use a CSPRNG for security contexts"
        }
        sink "list.random" {
            fix "Use a CSPRNG for security contexts"
        }
        sink "Math.random" {
            fix "Use crypto.getRandomValues() or a CSPRNG for security contexts"
        }
        sink "Random.rand" {
            fix "Use SecureRandom.rand for security contexts"
        }
        sink "random" {
            sanitizer "SecureRandom"
            sanitizer "Secure"
            sanitizer "Crypto"
            fix "Use SecureRandom or a CSPRNG for security contexts"
        }
    }
    conditions {
        skip_taint_check
    }
    message "Insecure random: {sink} may use a non-cryptographic PRNG. Use SecureRandom for security contexts."
}
