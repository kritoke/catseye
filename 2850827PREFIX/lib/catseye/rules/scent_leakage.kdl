rule "ScentLeakage" severity="Critical" {
    sinks {
        // Crystal log sinks
        sink "Logger.info" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "Logger.warn" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "Logger.error" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "Logger.debug" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "Logger.notice" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "Log.info" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "Log.warn" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "Log.error" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "Log.debug" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "Log.notice" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        // Crystal output sinks
        sink "puts" {
            fix "Avoid printing sensitive data — redact or mask before output"
        }
        sink "pp!" {
            fix "Avoid printing sensitive data — redact or mask before output"
        }
        sink "print" {
            fix "Avoid printing sensitive data — redact or mask before output"
        }
        sink "STDOUT.puts" {
            fix "Avoid printing sensitive data — redact or mask before output"
        }
        sink "STDOUT.write" {
            fix "Avoid printing sensitive data — redact or mask before output"
        }
        sink "STDERR.puts" {
            fix "Avoid printing sensitive data — redact or mask before output"
        }
        sink "STDERR.write" {
            fix "Avoid printing sensitive data — redact or mask before output"
        }
        sink "Log.write" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "Log.info" {
            fix "Avoid logging sensitive data — redact or mask before logging"
        }
        sink "IO.write" {
            fix "Avoid writing sensitive data to unsecured output — redact or mask"
        }
    }
    sources {
        source "password"
        source "token"
        source "secret"
        source "api_key"
        source "credential"
        source "email"
        source "ssn"
        source "credit_card"
        source "session_id"
    }
    message "Scent Leakage: sensitive data may reach {sink} via scented variable(s): {tainted_vars}."
}
