opam-version: "2.0"
synopsis: "Unified AST schema for Gleam and Crystal"
description:
  "Catseye's unified AST library - provides CatseyeAST.t schema bridging tree-sitter (Gleam) and native parser (Crystal)."
maintainer: ["Catseye Contributors"]
authors: ["Catseye Contributors"]
license: "MIT"
homepage: "https://github.com/kritoke/catseye"
bug-reports: "https://github.com/kritoke/catseye/issues"
depends: [
  "ocaml"
  "dune" {>= "3.17"}
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/kritoke/catseye.git"
