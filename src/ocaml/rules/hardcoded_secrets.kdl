rule "HardcodedSecrets" severity="High" {
    sinks {
        sink "password="
        sink "secret="
        sink "api_key="
        sink "token="
        sink "apikey="
        sink "access_token="
    }
    sources {
        source "literal"
    }
    message "Potential hardcoded secret: {sink}. Do not hardcode credentials in source code."
}
