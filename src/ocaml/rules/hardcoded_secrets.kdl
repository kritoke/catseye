rule "HardcodedSecrets" severity="High" {
    sinks {
        sink "password=" {
            fix "Load from environment variable: ENV[\"PASSWORD\"]? or a secrets manager"
        }
        sink "secret=" {
            fix "Load from environment variable: ENV[\"SECRET\"]? or a secrets manager"
        }
        sink "api_key=" {
            fix "Load from environment variable: ENV[\"API_KEY\"]? or a secrets manager"
        }
        sink "token=" {
            fix "Load from environment variable: ENV[\"TOKEN\"]? or a secrets manager"
        }
        sink "apikey=" {
            fix "Load from environment variable: ENV[\"API_KEY\"]? or a secrets manager"
        }
        sink "access_token=" {
            fix "Load from environment variable: ENV[\"ACCESS_TOKEN\"]? or a secrets manager"
        }
    }
    sources {
        source "literal"
    }
    message "Potential hardcoded secret: {sink}. Do not hardcode credentials in source code."
}
