rule "WeakCryptography" severity="Medium" {
    sinks {
        sink "Digest::MD5"
        sink "Digest::SHA1"
        sink "hashlib.md5"
        sink "hashlib.sha1"
    }
    conditions {
        skip_taint_check
    }
    message "Weak cryptography: {sink} uses a weak hashing algorithm (MD5/SHA1). Use SHA-256 or stronger."
}
