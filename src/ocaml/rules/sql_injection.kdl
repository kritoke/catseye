rule "SQLInjection" severity="Critical" {
    sinks {
        sink "db.exec" arg=0
        sink "db.query" arg=0
        sink "db.scalar" arg=0
        sink "db.query_one" arg=0
        sink "db.query_all" arg=0
        sink "db.execute" arg=0
        sink "database.exec" arg=0
        sink "database.query" arg=0
    }
    sources {
        source "params"
        source "query"
        source "user_input"
        source "request"
    }
    message "Potential SQL injection via {sink} with tainted argument(s): {tainted_vars}."
}
