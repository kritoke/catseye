rule "PathTraversal" severity="High" {
    sinks {
        sink "File.read" arg=0 {
            sanitizer "Path.basename"
            sanitizer "Path.dirname"
            sanitizer "Path.posix"
            sanitizer "Digest::MD5.hexdigest"
            sanitizer "Digest::SHA256.hexdigest"
            sanitizer "File.expand_path"
        }
        sink "File.write" arg=0 {
            sanitizer "Path.basename"
            sanitizer "Digest::MD5.hexdigest"
            sanitizer "Digest::SHA256.hexdigest"
            sanitizer "File.expand_path"
        }
        sink "File.delete" arg=0 {
            sanitizer "Digest::MD5.hexdigest"
            sanitizer "File.expand_path"
        }
        sink "File.open" arg=0 {
            sanitizer "Digest::MD5.hexdigest"
            sanitizer "File.expand_path"
        }
        sink "Dir.glob" arg=0
        sink "Dir.entries" arg=0
        sink "simplifile.read" arg=0
        sink "simplifile.write" arg=0
        sink "simplifile.delete" arg=0
    }
    sources {
        source "params" field="path"
        source "path"
        source "url"
        source "filename"
        source "filepath"
        source "user_path"
    }
    message "Potential path traversal via {sink} with variable argument(s): {tainted_vars}. Validate and sanitize path components."
}

rule "PathTraversal" severity="Medium" {
    sinks {
        sink "File.join" {
            sanitizer "Digest::MD5.hexdigest"
            sanitizer "Digest::SHA256.hexdigest"
        }
        sink "Path.join" {
            sanitizer "Digest::MD5.hexdigest"
            sanitizer "Digest::SHA256.hexdigest"
        }
    }
    sources {
        source "params" field="path"
        source "path"
        source "url"
        source "filename"
        source "filepath"
        source "user_path"
    }
    message "Potential path traversal via {sink} (path join) with variable argument(s): {tainted_vars}. Validate path components."
}
