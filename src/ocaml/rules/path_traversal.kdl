rule "PathTraversal" severity="High" {
    sinks {
        sink "File.read" {
            sanitizer "Path.basename"
            sanitizer "Path.dirname"
            sanitizer "Path.posix"
        }
        sink "File.write" {
            sanitizer "Path.basename"
        }
        sink "File.delete"
        sink "File.open"
        sink "Dir.glob"
        sink "Dir.entries"
        sink "simplifile.read"
        sink "simplifile.write"
        sink "simplifile.delete"
    }
    sources {
        source "params" field="path"
        source "path"
        source "url"
        source "filename"
        source "filepath"
        source "user_path"
    }
    message "Potential path traversal via {sink} with variable argument(s): {tainted_vars}. Validate and sanitize path components."
}

rule "PathTraversal" severity="Medium" {
    sinks {
        sink "File.join"
        sink "Path.join"
    }
    sources {
        source "params" field="path"
        source "path"
        source "url"
        source "filename"
        source "filepath"
        source "user_path"
    }
    message "Potential path traversal via {sink} (path join) with variable argument(s): {tainted_vars}. Validate path components."
}
