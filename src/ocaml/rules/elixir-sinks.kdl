rule "Elixir-SSRF" severity="High" languages="elixir" {
    // Elixir HTTP clients: HTTPoison, Tesla, Req, Mint
    sinks {
        sink "HTTPoison.get" arg=0 {
            sanitizer "URI.parse"
            sanitizer "URI.encode_www_form"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            sanitizer "safe_url?"
            fix "HTTPoison.get(URI.parse({arg0}))"
        }
        sink "HTTPoison.post" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "HTTPoison.post(URI.parse({arg0}), ...)"
        }
        sink "HTTPoison.put" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "HTTPoison.put(URI.parse({arg0}), ...)"
        }
        sink "HTTPoison.delete" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "HTTPoison.delete(URI.parse({arg0}), ...)"
        }
        sink "HTTPoison.request" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "HTTPoison.request(method, URI.parse({arg0}), ...)"
        }

        sink "Tesla.get" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "Tesla.get(client, URI.parse({arg0}), ...)"
        }
        sink "Tesla.post" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "Tesla.post(client, URI.parse({arg0}), ...)"
        }
        sink "Tesla.put" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "Tesla.put(client, URI.parse({arg0}), ...)"
        }
        sink "Tesla.delete" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "Tesla.delete(client, URI.parse({arg0}), ...)"
        }
        sink "Tesla.patch" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "Tesla.patch(client, URI.parse({arg0}), ...)"
        }

        sink "Req.get" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "Req.get(url: URI.parse({arg0}), ...)"
        }
        sink "Req.post" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "Req.post(url: URI.parse({arg0}), ...)"
        }
        sink "Req.put" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "Req.put(url: URI.parse({arg0}), ...)"
        }
        sink "Req.delete" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "Req.delete(url: URI.parse({arg0}), ...)"
        }
        sink "Req.request" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_url?"
            fix "Req.request(url: URI.parse({arg0}), ...)"
        }

        sink "Mint.HTTP.connect" arg=0 {
            sanitizer "URI.parse"
            sanitizer "validate_url"
            sanitizer "allowlisted_host?"
            fix "Mint.HTTP.connect(URI.parse_host({arg0}), ...)"
        }
    }
    sources {
        source "conn.params"
        source "conn.body"
        source "conn.query_params"
        source "conn.path_params"
        source "conn.req_body"
        source "conn.fetch_session"
        source "user_url"
        source "url"
        source "href"
    }
    message "Potential SSRF via {sink} with user-controlled URL from request"
}

rule "Elixir-SQL-Injection" severity="High" languages="elixir" {
    // Ecto database queries
    sinks {
        sink "Ecto.Repo.all" arg=0 {
            sanitizer "fragment"
            sanitizer "escape_string"
            sanitizer "sanitize"
            fix "Use Ecto.Query instead of raw fragments"
        }
        sink "Ecto.Repo.query" arg=0 {
            sanitizer "fragment"
            sanitizer "escape_string"
            fix "Use parameterized queries instead of string interpolation"
        }
        sink "Ecto.Repo.execute" arg=0 {
            sanitizer "fragment"
            sanitizer "escape_string"
            fix "Use parameterized queries"
        }
        sink "Repo.all" arg=0 {
            sanitizer "fragment"
            fix "Use Ecto.Query for safe queries"
        }
        sink "Repo.query" arg=0 {
            sanitizer "fragment"
            fix "Use Ecto.Query or parameterized queries"
        }
        sink "Ecto.Adapters.SQL.query" arg=1 {
            sanitizer "fragment"
            fix "Use parameterized queries"
        }
    }
    sources {
        source "conn.params"
        source "conn.body"
        source "conn.query_params"
        source "conn.path_params"
        source "user_input"
        source "id"
    }
    message "Potential SQL injection via {sink}"
}

rule "Elixir-Code-Execution" severity="Critical" languages="elixir" {
    // Code execution vulnerabilities
    sinks {
        sink "Code.eval_string" arg=0 {
            sanitizer "Code.eval_string(safe_string, ...)"
            fix "Avoid eval on user input"
        }
        sink "Code.eval" arg=0 {
            sanitizer "Code.eval(safe_string, ...)"
            fix "Avoid eval on user input"
        }
        sink "Kernel.eval" arg=0 {
            fix "Avoid eval on user input"
        }
        sink "Code.compile_string" arg=0 {
            fix "Avoid compile_string on untrusted input"
        }
        sink "Module.concat" arg=0 {
            sanitizer "Module.safe_concat?"
            fix "Validate module name before concat"
        }
    }
    sources {
        source "conn.params"
        source "conn.body"
        source "conn.query_params"
        source "user_code"
        source "script"
    }
    message "Potential arbitrary code execution via {sink}"
}

rule "Elixir-XSS" severity="High" languages="elixir" {
    // Cross-site scripting in Phoenix
    sinks {
        sink "Phoenix.HTML.Safe.to_string" arg=0 {
            sanitizer "Phoenix.HTML.html_escape"
            fix "Always escape user input: Phoenix.HTML.html_escape({arg0})"
        }
        sink "raw" arg=0 {
            fix "Avoid raw() with user input"
        }
        sink "content_tag" arg=1 {
            sanitizer "Phoenix.HTML.html_escape"
            fix "Always escape content: content_tag(:div, html_escape({arg1}), ...)"
        }
        sink "text" arg=1 {
            fix "Use safe text content"
        }
        sink "html" arg=0 {
            fix "Avoid html/1 with user input"
        }
    }
    sources {
        source "conn.params"
        source "conn.body"
        source "conn.query_params"
        source "user_content"
        source "comment"
        source "message"
    }
    message "Potential XSS via {sink} - user input may not be escaped"
}

rule "Elixir-Config-Secrets" severity="Critical" languages="elixir" {
    // Hardcoded secrets in config
    sinks {
        sink "config :secret" value="secret_key_base"
        sink "config :secret" value="database_url"
        sink "config :secret" value="api_key"
        sink "config :secret" value="private_key"
        sink "System.get_env" arg=0 {
            sanitizer "System.fetch_env!"
            sanitizer "Application.fetch_env!"
        }
    }
    message "Potential hardcoded secret in {sink}"
}