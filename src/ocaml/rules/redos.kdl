rule "ReDoS" severity="Medium" {
    sinks {
        sink "Regex.new"
        sink "Regex.compile"
        sink "re.compile"
        sink "regexp.compile"
    }
    conditions {
        check_args_contain "+)+"
        check_args_contain "+)*"
        check_args_contain "*)+"
        check_args_contain "*)*"
        check_args_contain "?)"
    }
    message "Potential ReDoS: regex with nested quantifiers or overlapping groups. Catastrophic backtracking risk."
}
