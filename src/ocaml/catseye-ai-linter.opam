# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.4.0"
synopsis: "AI anti-pattern linter using AST analysis"
description:
  "Catseye AI Linter - detects AI hallucinated functions, deprecated patterns, and code quality issues using AST pattern matching."
maintainer: ["Catseye Contributors"]
authors: ["Catseye Contributors"]
license: "MIT"
homepage: "https://github.com/kritoke/catseye"
bug-reports: "https://github.com/kritoke/catseye/issues"
depends: [
  "ocaml"
  "dune" {>= "3.17"}
  "catseye-ast"
  "str"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/kritoke/catseye.git"
