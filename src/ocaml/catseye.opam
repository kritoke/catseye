# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Static security analysis for Crystal and Gleam applications"
description:
  "Catseye finds vulnerabilities like SSRF, command injection, path traversal, and more by combining AST-based extraction with taint tracking and pattern-matching rules."
maintainer: ["Catseye Contributors"]
authors: ["Catseye Contributors"]
license: "MIT"
homepage: "https://github.com/kritoke/catseye"
bug-reports: "https://github.com/kritoke/catseye/issues"
depends: [
  "ocaml"
  "dune" {>= "3.21"}
  "cmdliner"
  "toml"
  "kdl"
  "yojson"
  "bos"
  "rresult"
  "logs"
  "fmt"
  "eio"
  "eio_posix"
  "ocaml_sqlite3"
  "ocamlgraph"
  "alcotest"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/kritoke/catseye.git"
x-maintenance-intent: ["(latest)"]
