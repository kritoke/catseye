(lang dune 3.17)

(name catseye)
(version v0.4.3-31-g0355fb9-dirty)

(generate_opam_files true)

(source
 (github kritoke/catseye))

(authors "Catseye Contributors")

(maintainers "Catseye Contributors")

(license MIT)

(package
 (name catseye)
 (synopsis "Static security analysis for Crystal and Gleam applications")
 (description
  "Catseye finds vulnerabilities like SSRF, command injection, path traversal, and more by combining AST-based extraction with taint tracking and pattern-matching rules.")
 (depends
  (ocaml (>= 5.4.0))
  dune
  base
  stdio
  core
  incremental
  cmdliner
  toml
  kdl
  yojson
  bos
  rresult
  logs
  fmt
  eio
  eio_posix
  sqlite3
  ocamlgraph
  alcotest))

(package
 (name catseye-crowsnest)
 (synopsis "Catseye supply chain audit — CVE scanning and staleness detection")
 (description
  "Crow's Nest module for Catseye. Audits Crystal Shards and Gleam hex packages for known CVEs, end-of-life status, and maintenance staleness.")
 (allow_empty)
 (depends
  (ocaml (>= 5.4.0))
  dune
  base
  stdio
  yojson
  sqlite3))

(package
 (name catseye-ast)
 (synopsis "Unified AST schema for Gleam and Crystal")
 (description
  "Catseye's unified AST library - provides CatseyeAST.t schema bridging tree-sitter (Gleam) and native parser (Crystal).")
 (allow_empty)
 (depends
  (ocaml (>= 5.4.0))
  dune
  base
  stdio
  yojson
  incremental))

(package
 (name catseye-ai-linter)
 (synopsis "AI anti-pattern linter using AST analysis")
 (description
  "Catseye AI Linter - detects AI hallucinated functions, deprecated patterns, and code quality issues using AST pattern matching.")
 (allow_empty)
 (depends
  (ocaml (>= 5.4.0))
  dune
  base
  stdio
  catseye-ast))
